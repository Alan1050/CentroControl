# The frontend uses its own origin, including on Netlify.
# Set this only when connecting to a different published CentroControl:
# VITE_API_URL=https://centrocontrolneuro.netlify.app

# Server-only configuration for the camera MVP. Netlify scope: Functions.
# Opción 1: Google AI (Gemini) - Gratuito en https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash

# Opción 2: OpenAI
# OPENAI_API_KEY=your-server-only-key
# VISION_MODEL=gpt-4o-mini

# Opción 3: Modo de prueba sin API externa (activa visión simulada de cámara)
# MOCK_VISION=true

# API_ALLOWED_ORIGINS=https://centrocontrolneuro.netlify.app,https://your-ojos-web.example

# No physiological sensors, GRU service or additional hosting is needed for this MVP.
